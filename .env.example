# Deployment origin used for canonical tags, sitemap and robots.txt.
# Leave unset to build against the Cloudflare Pages URL.
# SITE_URL="https://unitconversionhub.com"

# Browser bundle reads the VITE_ prefixed copy at build time.
# VITE_SITE_URL="https://unitconversionhub.com"

# Optional: Gemini key used by the original AI Studio scaffold. Not required to
# build or run the converter.
# GEMINI_API_KEY=""
